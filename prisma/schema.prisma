generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Histories {
  id          String   @id @default(uuid())
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Roles {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(255)
  users       Users[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Users {
  id        String   @id @default(uuid())
  email     String   @unique(map: "email") @db.VarChar(255)
  name      String?  @db.VarChar(255)
  password  String   @db.VarChar(255)
  roleId    String   @db.VarChar(255)
  role      Roles    @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Events {
  id                  String            @id @default(uuid())
  slug                String            @unique @db.VarChar(255)
  name                String            @db.VarChar(255)
  description         String?           @db.Text
  registrationPrefix  String            @db.VarChar(50)
  visitorSeq          Int               @default(0)
  isActive            Boolean           @default(true)
  startsAt            DateTime?
  endsAt              DateTime?
  fields              EventFormFields[]
  visitors            Visitors[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model EventFormFields {
  id             String   @id @default(uuid())
  eventId        String   @db.VarChar(191)
  event          Events   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  key            String   @db.VarChar(100)
  labelId        String   @db.VarChar(255)
  labelEn        String?  @db.VarChar(255)
  type           String   @db.VarChar(50)
  required       Boolean  @default(false)
  sortOrder      Int      @default(0)
  showInTable    Boolean  @default(false)
  indexAs        String?  @db.VarChar(50)
  uniquePerEvent Boolean  @default(false)
  validation     Json?
  options        Json?
  conditions     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([eventId, key])
  @@index([eventId])
}

model Visitors {
  id             String    @id @default(uuid())
  eventId        String    @db.VarChar(191)
  event          Events    @relation(fields: [eventId], references: [id])
  registrationId String    @unique @db.VarChar(100)
  fullName       String?   @db.VarChar(255)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(255)
  identityNumber String?   @db.VarChar(50)
  payload        Json
  language       String    @db.Char(2)
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([eventId])
  @@index([email])
  @@index([identityNumber])
}

model BoothTypes {
  id         String       @id @default(uuid())
  name       String       @db.VarChar(255)
  size       Int
  price      Float?
  isActive   Boolean      @default(true)
  booths     Booths[]
  exhibitors Exhibitors[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model Booths {
  id          String       @id @default(uuid())
  number      Int
  boothTypeId String       @db.VarChar(255)
  boothType   BoothTypes   @relation(fields: [boothTypeId], references: [id])
  isBooked    Boolean      @default(false)
  isActive    Boolean      @default(true)
  exhibitors  Exhibitors[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Exhibitors {
  id          String     @id @default(uuid())
  companyName String     @db.VarChar(255)
  picName     String     @db.VarChar(255)
  email       String     @db.VarChar(255)
  phone       String     @db.VarChar(255)
  notes       String?    @db.VarChar(255)
  productType String     @db.VarChar(255)
  boothTypeId String     @db.VarChar(255) // Tipe booth yang diinginkan (dipilih oleh exhibitor)
  boothType   BoothTypes @relation(fields: [boothTypeId], references: [id])
  boothId     String?    @db.VarChar(255) // Booth spesifik (diassign oleh admin)
  booth       Booths?    @relation(fields: [boothId], references: [id])
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}
